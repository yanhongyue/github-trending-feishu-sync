# ============================================================
# GitHub Trending -> 飞书 配置示例（脱敏）
# 复制本文件为 .env 后填入你的测试凭证。切勿提交真实密钥。
# 说明：.env 中留空则使用下方默认值。
# ============================================================

# ---------- GitHub 采集 ----------
GITHUB_TRENDING_URL=https://github.com/trending?since=daily
TOP_N=10
TZ_NAME=Asia/Shanghai
# 仅当运行环境存在 TLS 证书异常（如受限内网代理）时设为 true，默认 false
IGNORE_HTTPS_ERRORS=false
PAGE_TIMEOUT_MS=60000

# ---------- 飞书开放平台 ----------
FEISHU_BASE_URL=https://open.feishu.cn
# 自建应用的 App ID / App Secret（在飞书开放平台后台获取）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 可选：自定义 CA 证书文件路径（受限内网代理导致证书校验失败时使用，如 /etc/ssl/certs/ca-certificates.crt）
FEISHU_CA_BUNDLE=
# 多维表格：App Token（bitable URL 中 base 后的一段）与数据表 ID
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
# 多维表格网页版链接（用于日报展示），形如 https://xxx.feishu.cn/base/xxxx?table=tblxxxx
FEISHU_BITABLE_URL=
# 测试群 chat_id（机器人所在群）
FEISHU_CHAT_ID=

# ---------- 网络与重试 ----------
HTTP_TIMEOUT=20
MAX_RETRIES=3
RETRY_BACKOFF=1.5
